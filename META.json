{
  "name": "svs",
  "abstract": "SVS Vamana index access method for pgvector",
  "description": "Adds the Vamana approximate nearest neighbor index access method, built on the Intel Scalable Vector Search (SVS) library, to pgvector. Requires the Intel SVS C API library; set SVS_INSTALL to its install prefix.",
